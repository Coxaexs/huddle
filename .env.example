# ==============================================================================
# Hoffle settings for Docker Compose
#
# You do NOT need this file for a first run: `docker compose up -d` works as is.
# To change something: cp .env.example .env, edit .env, then run
# `docker compose up -d` again to apply it.
#
# Lines starting with # are ignored. Remove the # in front of a setting to use it.
# Full reference: docs/configuration.md
# ==============================================================================

# Port Hoffle is reachable on from your browser (http://localhost:8730).
# HOFFLE_PORT=8730

# ---- Security ---------------------------------------------------------------
# Both are generated automatically on first start and saved in state/secrets.env.
# Set them here only if you want to choose them yourself.
#
# Code needed to create the very first (owner) account.
# BOOTSTRAP_CODE=
# Secret used by bots and internal services.
# BOT_TOKEN=

# ---- Web address ------------------------------------------------------------
# Hoffle serves the app under /hangout, and plain / redirects there.
# BASE_PATH=/hangout
# Domains that should show the public landing page instead of the app.
# LANDING_DOMAINS=

# ---- Voice ------------------------------------------------------------------
# STUN/TURN servers for voice calls (JSON). The default public STUN server works
# for most home networks. See docs/self-hosting.md#voice if calls fail to connect.
# HUDDLE_ICE_SERVERS=[{"urls":["stun:stun.cloudflare.com:3478"]}]
#
# LiveKit media server for large voice rooms (docker compose --profile livekit).
# LIVEKIT_URL=wss://livekit.example.com
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# ---- Extras -----------------------------------------------------------------
# GIF search in the message box. Free key from https://klipy.com
# KLIPY_API_KEY=
#
# Push notifications when the tab is closed. Generate keys with:
#   docker compose exec hoffle npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
