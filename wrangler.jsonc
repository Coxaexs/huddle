{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huddle",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  // Local tracing is switched off by X_LOCAL_OBSERVABILITY=false (deploy/huddle-service).
  "observability": { "enabled": false },
  "assets": {
    "directory": "./dist/client",
    // Bound so the worker can serve /hangout/assets/* itself: the built asset
    // paths have no basePath, so nothing else resolves them under /hangout.
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "HUB", "class_name": "HuddleHub" },
      // Holds the WebSocket of every connected Discord-compatible bot.
      { "name": "DISCORD_GATEWAY", "class_name": "DiscordGateway" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HuddleHub"] },
    { "tag": "v2", "new_sqlite_classes": ["DiscordGateway"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "site-creator-d1",
      // Keep this id stable: `wrangler dev --persist-to state` keys the local
      // SQLite file off it, and that file holds the real message history.
      "database_id": "00000000-0000-4000-8000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "site-creator-r2"
    },
    {
      // Files up to 2 GB from people an admin picked, deleted after 12 hours
      // (lib/big-uploads.ts). Its own bucket so the backups can skip it.
      "binding": "BIG_UPLOADS",
      "bucket_name": "hoffle-big-uploads"
    }
  ],
  "vars": {
    // Overridden per-host by the systemd unit; these are the defaults.
    "MUSICWATCH_BASE_URL": "http://127.0.0.1:8722",
    "MUSIC_HELPER_BASE_URL": "http://127.0.0.1:8731",
    "DND_BASE_URL": "http://127.0.0.1:8000",
    "MUSICWATCH_PUBLIC_URL": "https://chat.hoffle.online",
    "DND_PUBLIC_URL": "https://dnd.deeppixel.online",
    // The consent-gated D&D session recorder is disabled; set to "1" to
    // re-enable it without deleting any code or data.
    "FEATURE_RECORD_SESSIONS": "0",
    // Side features to switch off without a code change, comma-separated ids
    // from SIDE_FEATURES in lib/features.ts, e.g. "games,battlemap". Their API
    // routes then answer 503; core chat cannot be listed here.
    "FEATURES_DISABLED": "",
    // Who may open /hangout/admin (and /admin/media) besides site admins: flo
    // and kiwi. Account ids, not usernames, since a username can be changed and reused.
    "ADMIN_IDS": "ac9e8e27-6cd9-4df1-af7a-afd85a59caa0,b4203f0e-38a7-43f1-b1b5-374116afb49d"
  }
}
