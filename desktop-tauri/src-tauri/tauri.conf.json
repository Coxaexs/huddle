{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hoffle Lite",
  "version": "1.1.1",
  "identifier": "online.hoffle.lite",
  "build": {
    "devUrl": "https://chat.hoffle.online",
    "frontendDist": "https://chat.hoffle.online"
  },
  "app": {
    "windows": [
      {
        "title": "Hoffle",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "iOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
