{
  "name": "huddle-desktop",
  "version": "2.0.0",
  "private": true,
  "description": "Hoffle desktop app (Electron shell around chat.hoffle.online)",
  "author": "coxaexs",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "node native/build.js mac && electron-builder --mac",
    "dist:win": "node native/build.js win && electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "online.deeppixel.huddle",
    "productName": "Hoffle",
    "npmRebuild": false,
    "afterPack": "build/adhoc-sign.js",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Hoffle uses your camera for video calls.",
        "NSMicrophoneUsageDescription": "Hoffle uses your microphone for voice chat.",
        "NSScreenCaptureUsageDescription": "Hoffle needs screen recording to share your screen.",
        "NSAudioCaptureUsageDescription": "Hoffle captures the audio of the apps you share, so it goes out with your screen share."
      },
      "extraResources": [
        {
          "from": "native/bin/hoffle-app-audio",
          "to": "hoffle-app-audio"
        }
      ]
    },
    "dmg": {
      "title": "Hoffle${arch}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "native/bin/hoffle-app-audio.exe",
          "to": "hoffle-app-audio.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Hoffle"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Network",
      "target": [
        "AppImage"
      ]
    }
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.4"
  }
}
