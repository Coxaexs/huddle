<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron needs these two under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Camera and microphone for calls. Screen recording is a runtime TCC
         prompt, not an entitlement. -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Asking Spotify what plays (profile) and playing songs in it (listen
         along) are Apple events; needed if the hardened runtime is turned on. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
