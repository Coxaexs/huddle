# ==========================================
# Hoffle: All-in-One Standalone Container
# Single container with:
# - Hoffle Web App & Realtime Worker (Port 8730)
# - Python yt-dlp Music Helper (Port 8731)
# ==========================================

FROM node:22-bookworm-slim AS runner

# Install Python 3, pip, ffmpeg, ca-certificates, and tini for process supervision
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    ffmpeg \
    ca-certificates \
    curl \
    sqlite3 \
    tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies for the music helper
COPY huddle_music_helper.py /app/
RUN python3 -m venv /app/pyenv && \
    /app/pyenv/bin/pip install --no-cache-dir aiohttp yt-dlp

# Copy package dependencies and install
COPY package.json package-lock.json tsconfig.json vite.config.ts next.config.js wrangler.jsonc /app/
RUN npm ci

# Copy application source code
COPY app/ /app/app/
COPY lib/ /app/lib/
COPY worker/ /app/worker/
COPY public/ /app/public/
COPY types/ /app/types/
COPY scripts/ /app/scripts/

# Build client bundle and worker
RUN npm run build

# Default environment variables
ENV NODE_ENV=production
ENV PORT=8730
ENV HOST=0.0.0.0
ENV PERSIST_DIR=/app/state
ENV MUSIC_HELPER_BASE_URL=http://127.0.0.1:8731

# Persistent storage for SQLite (D1) and uploads (R2)
RUN mkdir -p /app/state
VOLUME ["/app/state"]

# The music helper stays on loopback inside the container; only the web app
# needs to be published.
EXPOSE 8730

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8730/api/health > /dev/null || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/app/scripts/entrypoint-all-in-one.sh"]
