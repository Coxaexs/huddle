// Lets coxaexs stop, start and restart huddle.service without a password, so
// scripts/deploy.sh can swap a build in with the service stopped instead of
// under wrangler's file watcher. Nothing else is allowed.
//   sudo install -m 0644 deploy/huddle-service/50-huddle-deploy.rules /etc/polkit-1/rules.d/
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      action.lookup("unit") == "huddle.service" &&
      ["start", "stop", "restart"].indexOf(action.lookup("verb")) >= 0 &&
      subject.user == "coxaexs") {
    return polkit.Result.YES;
  }
});
