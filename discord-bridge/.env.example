# Hoffle Discord bridge. Copy to discord-bridge/.env and fill in.
#
# One bridge serves every Hoffle server: each server links its own Discord
# server and picks its channels in Server Settings -> Integrations ->
# Discord Bridge. Nothing per server goes in this file.

# The Discord bot every Hoffle server shares, from
# https://discord.com/developers/applications (Bot tab). Turn on
# "Message Content Intent" there, or messages arrive empty.
DISCORD_BOT_TOKEN=

# Hoffle's own BOT_TOKEN (from Hoffle's .env); the bridge derives its own
# token from it. Or point at Hoffle's .env instead:
HOFFLE_BOT_TOKEN=
# HOFFLE_ENV_FILE=../.env

# Where Hoffle answers from this machine, and its base path.
# HOFFLE_URL=http://127.0.0.1:8730
# HOFFLE_BASE_PATH=/hangout

# The public site, so Discord can load pictures and links (https).
# HOFFLE_PUBLIC_URL=https://hoffle.example

# Optional
# BRIDGE_STATE_DIR=./state
# BRIDGE_HEALTH_PORT=8733
# BRIDGE_CATCH_UP_HOURS=12
