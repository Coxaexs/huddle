# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Huddle's BOT_TOKEN (same value as BOT_TOKEN in huddle/.dev.vars)
HUDDLE_BOT_TOKEN=your_huddle_bot_token_here

# Huddle server URL (default: http://127.0.0.1:8730)
HUDDLE_URL=http://127.0.0.1:8730

# Huddle base path (default: /hangout)
HUDDLE_BASE_PATH=/hangout

# Default Huddle channel when no channel map is configured (default: general)
HUDDLE_DEFAULT_CHANNEL=general

# Channel mapping: Discord channel → Huddle channel
# Use Discord channel IDs or names, separated by commas
# Format: discord_channel:huddle_channel,discord_channel:huddle_channel
#
# Examples:
#   By channel name: general:general,memes:memes,game-night:game-night
#   By Discord channel ID: 123456789012345678:general,987654321098765432:memes
#   Mixed: 123456789012345678:general,memes:memes
DISCORD_TO_HUDDLE_MAP=genel:genel,miksiz:miksiz