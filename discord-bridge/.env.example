# Discord bridge settings. Copy to discord-bridge/.env and fill in.
# Start with: docker compose --profile bridge up -d

# Bot token from https://discord.com/developers/applications (Bot tab).
# Turn on "Message Content Intent" for the bot.
DISCORD_BOT_TOKEN=

# A Hoffle bot token: Server Settings -> Bots & Integrations -> Create Bot Integration.
HUDDLE_BOT_TOKEN=

# Which Discord channel maps to which Hoffle channel: discord_id:hoffle_channel,...
DISCORD_TO_HUDDLE_MAP=

# Hoffle channel used when a Discord channel has no mapping.
# HUDDLE_DEFAULT_CHANNEL=general

# Set automatically when run with Docker Compose.
# HUDDLE_URL=http://hoffle:8730
# HUDDLE_BASE_PATH=/hangout
